# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only, never expose
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # public; only used for signed uploads

# ---- Access ----
STUDIO_USER=tommy                           # browser login prompt
STUDIO_PASSWORD=change-me
PIPELINE_API_KEY=long-random-string         # lets your pipeline call the API without the prompt

# ---- Rendering ----
# Public URL of this app (Puppeteer loads /render/:id from it).
# On Netlify this falls back to the production domain if unset.
APP_URL=http://localhost:3000
# Local dev only (Mac/PC): path to your installed Chrome
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Image sourcing (POST /api/source/:id) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if the API says web fetch needs a beta header on your account:
# ANTHROPIC_BETA=web-fetch-2025-09-10
MIN_IMAGE_SHORT_SIDE=1000
# Memory ceiling for candidate downloads (they're held until the request ends)
MAX_SOURCE_BYTES=188743680        # 180 MB total
MAX_SOURCE_IMAGE_BYTES=41943040   # 40 MB per photo
