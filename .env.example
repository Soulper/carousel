# ---- Supabase (Project Settings → API Keys) ----
# Dashboard shows two key types. Use the NEW ones; the legacy anon/service_role
# keys are deprecated at the end of 2026.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # "Secret key" — server only, bypasses RLS, never expose
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # "Publishable key" — public, signed uploads only

# ---- Access ----
# Both are required or /login reports a 503 saying so. Values are trimmed, so a
# trailing newline from a dashboard paste is fine.
STUDIO_USER=studio
STUDIO_PASSWORD=change-me
PIPELINE_API_KEY=long-random-string         # lets your pipeline call the API without logging in

# ---- Rendering ----
# Public URL of this app (Puppeteer loads /render/:id from it). Set this
# explicitly on Vercel, or leave CHROME_EXECUTABLE_PATH unset there.
APP_URL=http://localhost:3000
# Local dev only: path to your installed Chrome.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Image sourcing and copy (POST /api/source/:id, /api/copy/:id) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if the API says web fetch needs a beta header on your account:
# ANTHROPIC_BETA=web-fetch-2025-09-10
MIN_IMAGE_SHORT_SIDE=1000
# Memory ceiling for candidate downloads (they're held until the request ends)
MAX_SOURCE_BYTES=188743680        # 180 MB total
MAX_SOURCE_IMAGE_BYTES=41943040   # 40 MB per photo

# ---- Autopilot: posting to Instagram (POST /api/cron/tick) ----
# Requires an IG Business/Creator account linked to a Facebook Page, and an
# app with instagram_content_publish granted. Long-lived tokens last ~60 days;
# FB_APP_ID + FB_APP_SECRET let GET /api/ig/refresh exchange for a fresh one.
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAG...
FB_APP_ID=
FB_APP_SECRET=

# ---- AI provider (topic, copy, image sourcing) ----
# Auto: uses Anthropic when ANTHROPIC_API_KEY is set, otherwise Gemini.
# Gemini's free tier covers search grounding, vision and JSON output.
AI_PROVIDER=            # gemini | anthropic | (unset = auto)
GEMINI_API_KEY=         # aistudio.google.com -> Get API key (free)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite   # used when the main model's daily free quota runs out
